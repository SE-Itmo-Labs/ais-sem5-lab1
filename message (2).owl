<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:civ="http://example.org/civilization#"
         xml:base="http://example.org/civilization">

  <owl:Ontology rdf:about="http://example.org/civilization">
    <rdfs:label>Civilization Game Ontology</rdfs:label>
  </owl:Ontology>

  <!-- ==================== КЛАССЫ ==================== -->

  <owl:Class rdf:about="#UnitType">
    <rdfs:label>Unit Type</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="#MilitaryUnit">
    <rdfs:subClassOf rdf:resource="#UnitType"/>
    <rdfs:label>Military Unit</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="#NonMilitaryUnit">
    <rdfs:subClassOf rdf:resource="#UnitType"/>
    <rdfs:label>Non-Military Unit</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="#Civilization">
    <rdfs:label>Civilization</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="#Era">
    <rdfs:label>Era</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="#Building">
    <rdfs:label>Building</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="#District">
    <rdfs:label>District</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="#Technology">
    <rdfs:label>Technology</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="#Resource">
    <rdfs:label>Resource</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="#VictoryType">
    <rdfs:label>Victory Type</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="#UniqueAbility">
    <rdfs:label>Unique Ability</rdfs:label>
  </owl:Class>

  <!-- ==================== OBJECT PROPERTIES ==================== -->

  <owl:ObjectProperty rdf:about="#requiresResource">
    <rdfs:domain rdf:resource="#UnitType"/>
    <rdfs:range rdf:resource="#Resource"/>
    <rdfs:label>requires resource</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#availableInEra">
    <rdfs:domain rdf:resource="#UnitType"/>
    <rdfs:range rdf:resource="#Era"/>
    <rdfs:label>available in era</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#unlocksUnit">
    <rdfs:domain rdf:resource="#Technology"/>
    <rdfs:range rdf:resource="#UnitType"/>
    <rdfs:label>unlocks unit</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#civUniqueUnit">
    <rdfs:domain rdf:resource="#Civilization"/>
    <rdfs:range rdf:resource="#UnitType"/>
    <rdfs:label>civilization unique unit</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#civUniqueAbility">
    <rdfs:domain rdf:resource="#Civilization"/>
    <rdfs:range rdf:resource="#UniqueAbility"/>
    <rdfs:label>civilization unique ability</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#buildingInDistrict">
    <rdfs:domain rdf:resource="#Building"/>
    <rdfs:range rdf:resource="#District"/>
    <rdfs:label>building in district</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#eraBefore">
    <rdfs:domain rdf:resource="#Era"/>
    <rdfs:range rdf:resource="#Era"/>
    <rdfs:label>era before</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasVictoryCondition">
    <rdfs:domain rdf:resource="#Civilization"/>
    <rdfs:range rdf:resource="#VictoryType"/>
    <rdfs:label>has victory condition</rdfs:label>
  </owl:ObjectProperty>

  <!-- ==================== DATA PROPERTIES ==================== -->

  <owl:DatatypeProperty rdf:about="#name">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>name</rdfs:label>
  </owl:DatatypeProperty>

  <!-- ==================== ЭПОХИ ==================== -->

  <owl:NamedIndividual rdf:about="#ancient">
    <rdf:type rdf:resource="#Era"/>
    <civ:name>Ancient</civ:name>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#classical">
    <rdf:type rdf:resource="#Era"/>
    <civ:name>Classical</civ:name>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#medieval">
    <rdf:type rdf:resource="#Era"/>
    <civ:name>Medieval</civ:name>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#renaissance">
    <rdf:type rdf:resource="#Era"/>
    <civ:name>Renaissance</civ:name>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#industrial">
    <rdf:type rdf:resource="#Era"/>
    <civ:name>Industrial</civ:name>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#modern">
    <rdf:type rdf:resource="#Era"/>
    <civ:name>Modern</civ:name>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#information">
    <rdf:type rdf:resource="#Era"/>
    <civ:name>Information</civ:name>
  </owl:NamedIndividual>

  <!-- ==================== ПОРЯДОК ЭПОХ ==================== -->

  <rdf:Description rdf:about="#ancient">
    <civ:eraBefore rdf:resource="#classical"/>
    <civ:eraBefore rdf:resource="#medieval"/>
    <civ:eraBefore rdf:resource="#renaissance"/>
    <civ:eraBefore rdf:resource="#industrial"/>
    <civ:eraBefore rdf:resource="#modern"/>
    <civ:eraBefore rdf:resource="#information"/>
  </rdf:Description>

  <rdf:Description rdf:about="#classical">
    <civ:eraBefore rdf:resource="#medieval"/>
    <civ:eraBefore rdf:resource="#renaissance"/>
    <civ:eraBefore rdf:resource="#industrial"/>
    <civ:eraBefore rdf:resource="#modern"/>
    <civ:eraBefore rdf:resource="#information"/>
  </rdf:Description>

  <rdf:Description rdf:about="#medieval">
    <civ:eraBefore rdf:resource="#renaissance"/>
    <civ:eraBefore rdf:resource="#industrial"/>
    <civ:eraBefore rdf:resource="#modern"/>
    <civ:eraBefore rdf:resource="#information"/>
  </rdf:Description>

  <rdf:Description rdf:about="#renaissance">
    <civ:eraBefore rdf:resource="#industrial"/>
    <civ:eraBefore rdf:resource="#modern"/>
    <civ:eraBefore rdf:resource="#information"/>
  </rdf:Description>

  <rdf:Description rdf:about="#industrial">
    <civ:eraBefore rdf:resource="#modern"/>
    <civ:eraBefore rdf:resource="#information"/>
  </rdf:Description>

  <rdf:Description rdf:about="#modern">
    <civ:eraBefore rdf:resource="#information"/>
  </rdf:Description>

  <!-- ==================== РЕСУРСЫ ==================== -->

  <owl:NamedIndividual rdf:about="#iron">
    <rdf:type rdf:resource="#Resource"/>
    <civ:name>Iron</civ:name>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#horses">
    <rdf:type rdf:resource="#Resource"/>
    <civ:name>Horses</civ:name>
  </owl:NamedIndividual>

  <!-- ==================== ВОЕННЫЕ ЮНИТЫ ==================== -->

  <owl:NamedIndividual rdf:about="#warrior">
    <rdf:type rdf:resource="#MilitaryUnit"/>
    <civ:name>Warrior</civ:name>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#archer">
    <rdf:type rdf:resource="#MilitaryUnit"/>
    <civ:name>Archer</civ:name>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#horseman">
    <rdf:type rdf:resource="#MilitaryUnit"/>
    <civ:name>Horseman</civ:name>
    <civ:requiresResource rdf:resource="#horses"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#catapult">
    <rdf:type rdf:resource="#MilitaryUnit"/>
    <civ:name>Catapult</civ:name>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#karavella">
    <rdf:type rdf:resource="#MilitaryUnit"/>
    <civ:name>Karavella</civ:name>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#swordsman">
    <rdf:type rdf:resource="#MilitaryUnit"/>
    <civ:name>Swordsman</civ:name>
    <civ:requiresResource rdf:resource="#iron"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#crossbowman">
    <rdf:type rdf:resource="#MilitaryUnit"/>
    <civ:name>Crossbowman</civ:name>
    <civ:requiresResource rdf:resource="#iron"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#knight">
    <rdf:type rdf:resource="#MilitaryUnit"/>
    <civ:name>Knight</civ:name>
    <civ:requiresResource rdf:resource="#horses"/>
    <civ:requiresResource rdf:resource="#iron"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#trebuchet">
    <rdf:type rdf:resource="#MilitaryUnit"/>
    <civ:name>Trebuchet</civ:name>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#caravel">
    <rdf:type rdf:resource="#MilitaryUnit"/>
    <civ:name>Caravel</civ:name>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#trireme">
    <rdf:type rdf:resource="#MilitaryUnit"/>
    <civ:name>Trireme</civ:name>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#scout">
    <rdf:type rdf:resource="#MilitaryUnit"/>
    <civ:name>Scout</civ:name>
  </owl:NamedIndividual>

  <!-- ==================== НЕВОЕННЫЕ ЮНИТЫ ==================== -->

  <owl:NamedIndividual rdf:about="#settler">
